# ShopCare v2 environment variables.
#
# Local: copy to .env (gitignored). `shopify app dev` injects the SHOPIFY_* and
# SCOPES values itself, so locally you mostly need the database and encryption
# lines. ShopCare sends no email itself (Shopify does), so there's no email
# provider to configure.
# Netlify: set these under Site configuration → Environment variables. Use
# per-context values (Production / Deploy Previews / Branch deploys) for the
# database so previews never touch production data.

# --- Shopify app (Partner dashboard → app → Client credentials) -------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated; must match [access_scopes] in shopify.app.toml.
SCOPES=read_products,write_customers,read_orders,write_draft_orders,write_orders,write_discounts,write_store_credit_account_transactions,read_merchant_managed_fulfillment_orders,write_merchant_managed_fulfillment_orders
# Public URL of the app: the tunnel in dev (set by the CLI), the Netlify site
# URL in production, e.g. https://shopcare.netlify.app
SHOPIFY_APP_URL=
# Optional: a custom shop domain to accept besides *.myshopify.com.
# SHOP_CUSTOM_DOMAIN=

# --- Database (Postgres) ----------------------------------------------------
# Runtime connection. Production: Neon's POOLED endpoint (host contains
# "-pooler"), with ?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL=postgresql://shopcare:shopcare@localhost:55433/shopcare_dev
# Direct, unpooled connection for `prisma migrate`. Production: Neon's direct
# endpoint. Locally, the same as DATABASE_URL.
DIRECT_URL=postgresql://shopcare:shopcare@localhost:55433/shopcare_dev
# Integration tests only (defaults to this value if unset).
# TEST_DATABASE_URL=postgresql://shopcare:shopcare@localhost:55433/shopcare_test

# --- App-level secrets --------------------------------------------------------
# AES-256-GCM key for encrypted columns (customer signing keys, Klaviyo keys,
# webhook secrets). Also used to derive the HMAC keys for signed file URLs and
# background-job dispatch. 32 random bytes, base64: openssl rand -base64 32
# Never change it without moving the old one to APP_ENCRYPTION_PREVIOUS_KEYS.
APP_ENCRYPTION_KEY=
# Comma-separated older keys, still accepted for decryption during rotation.
APP_ENCRYPTION_PREVIOUS_KEYS=

# --- Background work --------------------------------------------------------
# netlify (POST to the background function), inline (run in-process, for
# `shopify app dev`), or sync (await in-process, for tests). Defaults to
# netlify on Netlify and inline elsewhere. Set it explicitly on Netlify.
# BACKGROUND_DISPATCH=netlify
# Base URL for /.netlify/functions/*; defaults to SHOPIFY_APP_URL.
# BACKGROUND_FUNCTIONS_URL=

# --- File storage -----------------------------------------------------------
# netlify (Netlify Blobs), fs (local disk), or memory. Defaults to netlify on
# Netlify, fs locally, memory under Vitest.
# STORAGE_DRIVER=fs
# Netlify Blobs store name (default shopcare-files).
# STORAGE_BLOB_STORE=shopcare-files
# Local directory for the fs driver (default ./.storage).
# STORAGE_FS_ROOT=.storage

# --- Admin links --------------------------------------------------------------
# The app's handle in the Shopify admin URL (links to tickets in Flow staff
# alerts and on the postage slip's QR code), default shopcare.
# SHOPIFY_APP_HANDLE=shopcare
