{%- comment -%}
  Care — product page section, laid out after Apple's coverage picker: a
  headline, one card per Care plan (name, what it covers, price, benefits and
  a "What's covered" panel with the plan's terms), and a "No coverage" card.
  Colours and fonts come from the theme. The chosen plan is added with the
  product as a nested cart line (Shopify removes it with the product), tagged
  _shopcare_for so the cover attaches to the right item.
{%- endcomment -%}

{%- comment -%}
  Which plans apply is decided here, from the app's storefront data
  (app.metafields.shopcare.storefront: the active plans, each with its
  product rule), so the product page doesn't call the app. Rules match as the
  app's do: any of the group's collections or tags (case-insensitive), or the
  product type. Without that data (not published yet, or another version)
  the script asks the app instead (data-plans-url).
{%- endcomment -%}
{%- assign care_data = app.metafields.shopcare.storefront.value -%}
{%- assign use_data = false -%}
{%- if care_data.v == 1 -%}{%- assign use_data = true -%}{%- endif -%}
{%- assign plan_count = 0 -%}
{%- if use_data and product -%}
  {%- assign product_type = product.type | downcase -%}
  {%- capture plans_json -%}
    {%- for plan in care_data.plans -%}
      {%- assign applies = false -%}
      {%- case plan.rule.type -%}
        {%- when 'all' -%}
          {%- assign applies = true -%}
        {%- when 'collections' -%}
          {%- for collection in product.collections -%}
            {%- assign collection_id = collection.id | append: '' -%}
            {%- if plan.rule.collection_ids contains collection_id -%}{%- assign applies = true -%}{%- endif -%}
          {%- endfor -%}
        {%- when 'tags' -%}
          {%- for tag in product.tags -%}
            {%- assign tag_down = tag | downcase -%}
            {%- if plan.rule.tags contains tag_down -%}{%- assign applies = true -%}{%- endif -%}
          {%- endfor -%}
        {%- when 'product_type' -%}
          {%- if plan.rule.product_type == product_type -%}{%- assign applies = true -%}{%- endif -%}
      {%- endcase -%}
      {%- if applies -%}
        {%- if plan_count > 0 -%},{%- endif -%}
        {{- plan | json -}}
        {%- assign plan_count = plan_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
{%- endif -%}

{%- if product -%}{%- unless use_data and plan_count == 0 -%}
<div
  class="shopcare-pdp"
  data-care-offer
  data-plans-url="/apps/repairs/care_plans?product_id={{ product.id }}&product_title={{ product.title | url_encode }}"
  {%- if use_data %} data-plans-json="[{{ plans_json | escape }}]" data-currency="{{ care_data.currency | escape }}"{% endif %}
  data-cart-add-url="{{ routes.cart_add_url }}.js"
  data-cart-url="{{ routes.cart_url }}"
  data-cart-change-url="{{ routes.cart_change_url }}.js"
  data-product-title="{{ product.title | escape }}"
  data-subtitle="{{ block.settings.subtitle | escape }}"
  data-price-suffix="{{ block.settings.price_suffix | escape }}"
  data-decline-label="{{ block.settings.decline_label | escape }}"
  data-terms-label="{{ block.settings.terms_label | escape }}"
  {%- if block.settings.accent_color != blank %} style="--shopcare-accent-setting: {{ block.settings.accent_color }};"{% endif %}
  aria-busy="true"
  {{ block.shopify_attributes }}
>
  <h3 class="shopcare-pdp__title">
    <span class="shopcare-pdp__title-strong">{{ block.settings.heading }}</span>
    <span class="shopcare-pdp__title-muted">{{ block.settings.tagline }}</span>
  </h3>
  <div class="shopcare-pdp__choices" role="radiogroup" aria-label="{{ block.settings.heading | escape }}" data-care-options>
    {%- comment -%} Placeholders the size of a plan card and the no-thanks card, so
      the page doesn't jump when the plans arrive. Removed (with the whole block,
      if the product has no plans) by shopcare-pdp.js. {%- endcomment -%}
    <div class="shopcare-pdp__skeleton" aria-hidden="true"></div>
    <div class="shopcare-pdp__skeleton shopcare-pdp__skeleton--short" aria-hidden="true"></div>
  </div>
  <p class="shopcare-pdp__error" data-shopcare-error role="alert" hidden></p>
</div>
{%- endunless -%}{%- endif -%}

{% schema %}
{
  "name": "Care offer",
  "target": "section",
  "stylesheet": "shopcare.css",
  "javascript": "shopcare-pdp.js",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Care coverage." },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Peace of mind in every plan." },
    { "type": "text", "id": "subtitle", "label": "Plan subtitle", "info": "{months} and {product} are replaced.", "default": "Cover this product for {months} months" },
    { "type": "text", "id": "price_suffix", "label": "Price suffix", "default": "one-off" },
    { "type": "text", "id": "decline_label", "label": "No-thanks card", "default": "No Care coverage" },
    { "type": "text", "id": "terms_label", "label": "Terms heading", "info": "Opens the plan's terms, generated from its settings in ShopCare.", "default": "What's covered" },
    { "type": "color", "id": "accent_color", "label": "Selected colour", "info": "Optional. Leave blank to use your theme's button colour." }
  ]
}
{% endschema %}
