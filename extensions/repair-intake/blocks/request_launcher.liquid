{%- comment -%}
  App embed: a floating "Request a repair" button on every page that opens the
  repair request form in a dialog. Theme settings → App embeds.
{%- endcomment -%}

<div class="shopcare-launcher shopcare-launcher--{{ block.settings.position }}" data-shopcare-launcher>
  <button type="button" class="button shopcare-launcher__button" data-launcher-open>{{ block.settings.button_label }}</button>
  <dialog class="shopcare-launcher__dialog" data-launcher-dialog aria-label="{{ block.settings.button_label | escape }}">
    <button type="button" class="shopcare-launcher__close" data-launcher-close aria-label="Close">&times;</button>
    {% render 'shopcare_request_form', block: block, customer: customer, app: app %}
  </dialog>
</div>


{% schema %}
{
  "name": "Repair request button",
  "target": "body",
  "stylesheet": "repair-intake.css",
  "javascript": "repair-intake.js",
  "settings": [
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Request a repair" },
    { "type": "select", "id": "position", "label": "Position", "default": "bottom-right", "options": [
      { "value": "bottom-right", "label": "Bottom right" },
      { "value": "bottom-left", "label": "Bottom left" }
    ] },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Request a repair" },
    { "type": "textarea", "id": "confirmation_text", "label": "Confirmation message", "default": "Your repair request has been received. We'll email you a quote to pay or decline, then how to send us your item." },
    { "type": "checkbox", "id": "collect_address", "label": "Collect return address", "default": true },
    { "type": "range", "id": "max_images", "label": "Max photos", "min": 0, "max": 3, "step": 1, "default": 3 },
    { "type": "url", "id": "status_url", "label": "Repair status page", "info": "The page with the Repair status block. Linked from the confirmation." }
  ]
}
{% endschema %}
